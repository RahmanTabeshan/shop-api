PORT=5000
NODE_ENV=development
BASE_URL= # Optional: e.g. /api or leave empty for no prefix

# PostgreSQL Database Configuration
DATABASE_USER=postgres
DATABASE_PASS=your_password_here
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=shop_db

# Security & Authentication Configuration
JWT_SECRET=your_jwt_secret_min_32_chars_placeholder
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret_min_32_chars_placeholder
